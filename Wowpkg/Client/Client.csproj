<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Addon\Addon.csproj" />
    <ProjectReference Include="..\Catalog\Catalog.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Wowpkg</AssemblyName>
    <AssemblyVersion>0.5.0.0</AssemblyVersion>
  </PropertyGroup>

  <ItemGroup>
    <CatalogFiles Include="../Data/Catalog/**"></CatalogFiles>
    <Content Include="../WowpkgConfig.xml"></Content>
  </ItemGroup>

  <Target Name="CopyCatalogOnBuild" AfterTargets="AfterBuild">
    <Copy SourceFiles="@(CatalogFiles)" DestinationFolder="$(OutDir)/Catalog" />
  </Target>
  <Target Name="CopyCatalogOnPublish" AfterTargets="Publish">
    <Copy SourceFiles="@(CatalogFiles)" DestinationFolder="$(PublishDir)/Catalog" />
  </Target>

</Project>